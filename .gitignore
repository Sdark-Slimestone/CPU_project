# ========== Build Artifacts ==========
# Chisel generated Verilog (regenerated by `make genv`)
MyChisel/verilog/
MyChisel/DPI_Memory.v
MyChisel/filelist.f
MyChisel/npc_rv32

# sbt build cache
MyChisel/target/
MyChisel/project/target/

# Deployed core source (regenerated by `make deploy-core`)
MyChisel/src/main/

# NPC temp build
temper_npc/

# NVBoard user project
nvboard/myexample/

# Yosys-STA results, tools, PDK (downloaded by `make yosys-init`)
yosys-sta/result/
yosys-sta/bin/
yosys-sta/pdk/
yosys-sta/example/*.v
yosys-sta/example/*.sv

# ISA emulator build artifacts
isa-emu/*/build/
isa-emu/*/*.so
isa-emu/*/minirv

# NPC binary outputs
cpu-core/*/npc-core/

# ISA emulator shared libs (regenerated by `make emu`)
emu-so/

# Test binary artifacts (source: test-benchmarks/*.o/*.d kept)
test-benchmarks/*/*.bin
test-benchmarks/*/*.elf
test-benchmarks/*/*.txt
test-benchmarks/*/*.o
test-benchmarks/*/*.d

# NEMU .so is external, not part of this repo
nemu-so/