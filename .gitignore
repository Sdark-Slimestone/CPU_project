# ========== Build Artifacts ==========
# Chisel generated Verilog (regenerated by `make genv`)
MyChisel/verilog/
MyChisel/DPI_Memory.v
MyChisel/filelist.f
MyChisel/npc_rv32

# sbt build cache
MyChisel/target/
MyChisel/project/target/

# Deployed core source (regenerated by `make deploy-core`)
MyChisel/src/main/

# NPC temp build
temper_npc/

# Yosys-STA results & tools (too large, run make yosys-init to download)
yosys-sta/result/
yosys-sta/bin/
yosys-sta/pdk/
# SoC (ysyxSoC) 仿真 / NVBoard 构建产物
cpu-core/*/soc/obj_dir*/
cpu-core/*/soc/nvboard/build/
cpu-core/*/soc/nvboard/build_flash/
cpu-core/*/soc/rtl_flash/
cpu-core/*/soc/chiplink/
cpu-core/*/soc/rtl/
